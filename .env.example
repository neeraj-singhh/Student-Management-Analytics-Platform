# ========================================================
# Student Management & Analytics System — Environment Variables
# ========================================================

# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://postgres:5432/studentdb
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password

# Spring Security & JWT Configuration
# Generate a secure 256-bit base64 key for production: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Environment (Vite)
VITE_API_BASE_URL=/api

